<footer class="site-footer">
  <div class="wrap footer__inner">
    <img src="/images/logo.png" alt="<%= t.brand %>" class="footer__logo" />
    <div class="footer__links">
      <% if (socialLinks && socialLinks.length) { %>
        <span class="footer__label"><%= t.footer_follow %>:</span>
        <% socialLinks.forEach(function(social) { %>
          <a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"><%= social.name %></a>
        <% }); %>
        <span class="footer__sep">&middot;</span>
      <% } %>
      <a href="mailto:<%= footer.email %>"><%= t.footer_email %>: <%= footer.email %></a>
      <% if (contactNumbers && contactNumbers.length) { %>
        <% contactNumbers.forEach(function (c) { %>
          <a href="tel:<%= c.number.replace(/[^\d+]/g, '') %>"><%= c.label || t.footer_call %>: <%= c.number %></a>
        <% }); %>
      <% } %>
    </div>
    <p>&copy; <%= new Date().getFullYear() %> <%= footer.rightsText %></p>
  </div>
</footer>
