<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="<%= prefix %>/" class="wordmark">
      <img src="/images/logo.png" alt="<%= t.brand %>" class="site-logo" />
    </a>

    <form action="<%= prefix %>/shop" method="GET" class="nav-search" role="search">
      <input
        type="search"
        name="q"
        placeholder="<%= t.nav_search_placeholder %>"
        aria-label="<%= t.nav_search_aria %>"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
      />
      <button type="submit" aria-label="<%= t.nav_search_aria %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </form>

    <button type="button" class="nav-toggle" data-nav-toggle aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="main-nav" data-main-nav>
      <div class="nav-dropdown">
        <button type="button" class="nav-link" data-dropdown-toggle><%= t.nav_categories %></button>
        <ul class="nav-dropdown__menu">
          <% navCategories.forEach(function(cat) { %>
            <li><a href="<%= prefix %>/shop?category=<%= cat %>" class="<%= typeof activeCategory !== 'undefined' && activeCategory === cat ? 'is-active' : '' %>">
              <%= categoryLabel(cat) %>
            </a></li>
          <% }); %>
        </ul>
      </div>

      <a href="<%= prefix %>/shop" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'shop' ? 'is-active' : '' %>"><%= t.nav_shop %></a>

      <a href="<%= prefix %>/wishlist" class="nav-link nav-link--wishlist <%= typeof activeNav !== 'undefined' && activeNav === 'wishlist' ? 'is-active' : '' %>">
        <%= t.nav_wishlist %> <span class="wishlist-count" data-wishlist-count hidden>0</span>
      </a>

      <div class="nav-dropdown">
        <button type="button" class="nav-link" data-dropdown-toggle><%= t.nav_social %></button>
        <ul class="nav-dropdown__menu">
          <% socialLinks.forEach(function(social) { %>
            <li><a href="<%= social.url %>" target="_blank" rel="noopener noreferrer"><%= social.name %></a></li>
          <% }); %>
        </ul>
      </div>

      <a href="<%= altPath %>" class="nav-link nav-link--lang" hreflang="<%= altLocale %>"><%= t.lang_switch %></a>
    </nav>
  </div>
</header>
